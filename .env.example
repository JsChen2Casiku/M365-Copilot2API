# ==============================================================================
# M365-Copilot2API 配置模板
# 复制此文件为 .env 并在其中按需调整配置
# Docker Compose 会自动加载 .env 并完成参数联动
# ==============================================================================

# HTTP 绑定监听地址及端口（默认：127.0.0.1:4141）
# 在 Docker Compose 中，此地址将作为宿主机的端口映射（例如 127.0.0.1:4141 或 0.0.0.0:4141）
M365_LISTEN=127.0.0.1:4141

# 数据存储目录（Docker Compose 会将宿主机的该目录挂载至容器内 /data）
M365_DATA_DIR=./data

# Web 控制台与管理 API 管理员密码
# - 留空时：首次启动使用默认密码 admin123，并在首次登录时强制要求修改
# - 自定义密码时：请设置为强密码（系统会拒绝启动使用默认的 admin123）
M365_ADMIN_PASSWORD=

# 每个账号的最大同时上游调用并发数（默认 8）
M365_ACCOUNT_DEFAULT_CONCURRENCY=8

# 公开身份策略开关（默认 false；仅在微软反代渠道需要中立化身份输出时设为 true）
M365_PUBLIC_IDENTITY_POLICY=false

# 强制使用 IPv4（宿主机没有正常的 IPv6 出站路由到微软端点时设置为 1）
M365_FORCE_IPV4=0

# 日志输出级别（debug, info, warn, error，默认 info）
M365_LOG_LEVEL=info

# 请求超时设置（秒）
M365_CHAT_TIMEOUT_SECONDS=120
M365_IMAGE_TIMEOUT_SECONDS=150

# 云端对话自动清理开关（默认 true，自动回收闲置会话）
M365_AUTO_CLEANUP=true

# 出站代理设置（可选，支持 http://、https://、socks5://）
# M365_PROXY=http://127.0.0.1:7890
# M365_PROXY_POOL=

# 自定义 Microsoft Entra (Azure AD) OAuth 应用注册（可选）
# 不填写时将使用内置默认配置
# M365_BROWSER_CLIENT_ID=your-browser-application-client-id
# M365_BROWSER_AUTHORITY=https://login.microsoftonline.com/common
# M365_BROWSER_SCOPE=openid profile offline_access
# M365_BROWSER_REDIRECT_URI=https://login.microsoftonline.com/common/oauth2/nativeclient
# M365_DEVICE_CLIENT_ID=d3590ed6-52b3-4102-aeff-aad2292ab01c
# M365_DEVICE_AUTHORITY=https://login.microsoftonline.com/common
# M365_DEVICE_SCOPE=openid profile offline_access
